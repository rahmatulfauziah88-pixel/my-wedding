rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "rahmatulfauziyah88@gmail.com";
    }
    match /guests/{guestId} {
      allow get: if true;
      allow list, create, update, delete: if isAdmin();
    }
  }
}
